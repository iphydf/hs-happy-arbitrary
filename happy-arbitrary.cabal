name:          happy-arbitrary
version:       0.0.2
synopsis:      Token list generator for arbitrary Happy grammars.
homepage:      https://toktok.ltd/
license:       GPL-3
license-file:  LICENSE
author:        Iphigenia Df <iphydf@gmail.com>
maintainer:    Iphigenia Df <iphydf@gmail.com>
copyright:     Copyright (c) 2024, Iphigenia Df
category:      Data
stability:     Experimental
cabal-version: >=1.10
build-type:    Simple
description:   Generates token lists for a Happy grammar for testing parsers.

extra-source-files:
    test/examples/Cimple/Lexer.x
    test/examples/Cimple/Parser.y

source-repository head
  type:     git
  location: https://github.com/TokTok/hs-happy-arbitrary

library
  default-language: Haskell2010
  hs-source-dirs:   src
  ghc-options:      -Wall
  build-tools:      alex >=0, happy >=0
  exposed-modules:
    Language.Alex.Arbitrary
    Language.Alex.Ast
    Language.Alex.Parser
    Language.Happy.Arbitrary
    Language.Happy.Ast
    Language.Happy.Generate
    Language.Happy.GenTree
    Language.Happy.Grammar
    Language.Happy.Lexer
    Language.Happy.Linker
    Language.Happy.Mutation
    Language.Happy.Parser
    Language.Happy.Scope
    Language.Happy.Swarm
    Language.Happy.Tokens
    Language.Happy

  build-depends:
      QuickCheck
    , aeson
    , array
    , attoparsec
    , base                 <5
    , containers
    , bytestring
    , data-fix
    , extra
    , file-embed
    , mtl
    , text
    , transformers-compat

test-suite testsuite
  type:               exitcode-stdio-1.0
  default-language:   Haskell2010
  hs-source-dirs:     test
  main-is:            testsuite.hs
  other-modules:
      Examples.CimpleSpec
      Language.Happy.ArbitrarySpec
      Language.Happy.LinkerSpec
      Language.Happy.MutationSpec
      Language.Happy.ScopeSpec
      Language.Happy.SwarmSpec
  ghc-options:        -Wall
  build-tool-depends: hspec-discover:hspec-discover
  build-depends:
      base        <5
    , bytestring
    , containers
    , data-fix
    , directory
    , groom
    , hspec
    , process
    , QuickCheck
    , happy-arbitrary
    , text